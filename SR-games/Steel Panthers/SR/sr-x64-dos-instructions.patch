--- a/SR/SR_full_x64_instr.c
+++ b/SR/SR_full_x64_instr.c
@@ -417,6 +417,7 @@ int SR_disassemble_x64_instruction(unsigned int Entry, output_data *output, regi
         case UD_Ior:
         case UD_Ixor:
             /* CF,OF cleared, AF undefined, SF,ZF,PF - modified */
+        case UD_Ibsf:
         case UD_Ibsr:
             /* CF,OF,AF,SF,PF undefined, ZF - modified */
         case UD_Ibswap:
@@ -595,6 +596,60 @@ int SR_disassemble_x64_instruction(unsigned int Entry, output_data *output, regi
                 }
             }
 
+            break;
+        case UD_Iaam:
+            /* SF,ZF,PF - modified, OF,AF,CF - undefined; aam is invalid in 64-bit mode */
+            {
+                unsigned int imm = (ud_obj.operand[0].type == UD_OP_IMM) ? (ud_obj.operand[0].lval.ubyte) : 10;
+                OUTPUT_STRING("mov r9d, eax\n");
+                OUTPUT_STRING("movzx eax, al\n");
+                OUTPUT_PARAMSTRING("mov r8b, %u\n", imm);
+                OUTPUT_STRING("div r8b\n");
+                OUTPUT_STRING("xchg al, ah\n");
+                OUTPUT_STRING("and r9d, 0xffff0000\n");
+                OUTPUT_STRING("movzx eax, ax\n");
+                OUTPUT_STRING("or eax, r9d\n");
+                OUTPUT_STRING("test al, al");
+            }
+
+            break;
+        case UD_Iaad:
+            /* SF,ZF,PF - modified, OF,AF,CF - undefined; aad is invalid in 64-bit mode */
+            {
+                unsigned int imm = (ud_obj.operand[0].type == UD_OP_IMM) ? (ud_obj.operand[0].lval.ubyte) : 10;
+                OUTPUT_STRING("mov r9d, eax\n");
+                OUTPUT_STRING("shr r9d, 8\n");
+                OUTPUT_STRING("movzx r9d, r9b\n");
+                OUTPUT_PARAMSTRING("imul r9d, r9d, %u\n", imm);
+                OUTPUT_STRING("add r9b, al\n");
+                OUTPUT_STRING("and eax, 0xffff0000\n");
+                OUTPUT_STRING("movzx r9d, r9b\n");
+                OUTPUT_STRING("or eax, r9d\n");
+                OUTPUT_STRING("test al, al");
+            }
+
+            break;
+        case UD_Ifldlpi:
+            /* udis86 1.6 names fldpi "fldlpi" */
+            /* no flags affected */
+
+            OUTPUT_STRING("fldpi");
+
+            break;
+        case UD_Icmpsw:
+        case UD_Icmpsd:
+            /* OS,SF,ZF,AF,PF,CF - modified */
+            {
+                const char *suffix = (ud_obj.mnemonic == UD_Icmpsw) ? "cmpsw" : "cmpsd";
+                const char *prefix = "";
+
+                if (ud_obj.pfx_rep) prefix = "rep ";
+                else if (ud_obj.pfx_repe) prefix = "repe ";
+                else if (ud_obj.pfx_repne) prefix = "repne ";
+
+                OUTPUT_PARAMSTRING("%sa32 %s", prefix, suffix);
+            }
+
             break;
         case UD_Icwd:
             /* no flags affected */
