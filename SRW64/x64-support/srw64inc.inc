;; Support macros for assembler code generated by SRW64.
;;
;; Image relative addresses (RVAs) are written as RVA(label).
;; Address of the image base (PE header) is written as __ImageBase.

; addresses without "rel" keyword are absolute addresses
DEFAULT ABS

%ifidn __OUTPUT_FORMAT__, win64

    ; __ImageBase is provided by the linker (MSVC link, lld-link, GNU ld)
    extern __ImageBase

    ; image relative address (IMAGE_REL_AMD64_ADDR32NB relocation)
    %define RVA(x) x wrt ..imagebase

%elifidn __OUTPUT_FORMAT__, elf64

    ; ELF doesn't have image relative relocations - image base is zero,
    ; so image relative addresses are 32-bit absolute addresses
    ; and the executable must be linked into the low 2 GB of the address space
    ; (gcc -no-pie, default code model)
    %define __ImageBase 0

    %define RVA(x) x

    ; rel __ImageBase is an absolute address
    [warning -ea-absolute]

%else
    %error "unsupported output format (use win64 or elf64)"
%endif
