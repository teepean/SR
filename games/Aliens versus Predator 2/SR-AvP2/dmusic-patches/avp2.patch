+// Sequence tracks ('seqt'): MIDI-like events (DMUS_IO_SEQ_ITEM: time, duration, pchannel, offset, status, data) and
+// curves (DMUS_IO_CURVE_ITEM). Notes become note on/off messages, controller and pitch-bend events their messages;
+// controller and pitch-bend curves are sampled every few ticks.
+#define DmInt_SEQ_CURVE_SPACING 5
+
+static DmResult DmSegment_addSeqControl(DmMessageList* slf, uint32_t time, uint32_t channel, uint8_t cc, float value) {
+	DmMessage msg;
+	memset(&msg, 0, sizeof msg);
+	msg.type = DmMessage_CONTROL;
+	msg.time = time;
+	msg.control.control = cc;
+	msg.control.channel = channel;
+	msg.control.value = value;
+	msg.control.reset = false;
+	msg.control.reset_value = value;
+	return DmMessageList_add(slf, msg);
