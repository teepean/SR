+static DmResult DmSegment_addSeqPitchBend(DmMessageList* slf, uint32_t time, uint32_t channel, int value) {
+	DmMessage msg;
+	memset(&msg, 0, sizeof msg);
+	msg.type = DmMessage_PITCH_BEND;
+	msg.time = time;
+	msg.pitch_bend.channel = channel;
+	msg.pitch_bend.value = value;
+	msg.pitch_bend.reset = false;
+	msg.pitch_bend.reset_value = value;
+	return DmMessageList_add(slf, msg);
