+		} else if (DmRiff_is(&cnk, DM_FOURCC_CURL, 0)) {
+			rv = DmSegment_parseSequenceCurves(slf, &cnk);
+		}
+
+		if (rv != DmResult_SUCCESS) {
+			return rv;
+		}
+	}
+
+	return DmResult_SUCCESS;
+}
