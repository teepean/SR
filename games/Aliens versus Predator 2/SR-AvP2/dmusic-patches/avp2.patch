+static DmResult DmSegment_parseSequenceEvents(DmMessageList* slf, DmRiff* rif) {
+	uint32_t item_size = 0;
+	DmRiff_readDword(rif, &item_size);
+	if (item_size < 17) {
+		return DmResult_SUCCESS;
+	}
+
+	uint32_t item_count = (rif->len - rif->pos) / item_size;
+	for (uint32_t i = 0; i < item_count; ++i) {
+		uint32_t end_position = rif->pos + item_size;
+		uint32_t time = 0, duration = 0, channel = 0;
+		int16_t offset = 0;
+		uint8_t status = 0, b1 = 0, b2 = 0;
+
+		DmRiff_readDword(rif, &time);
+		DmRiff_readDword(rif, &duration);
+		DmRiff_readDword(rif, &channel);
+		DmRiff_readShort(rif, &offset);
+		DmRiff_readByte(rif, &status);
+		DmRiff_readByte(rif, &b1);
+		DmRiff_readByte(rif, &b2);
+		rif->pos = end_position;
+
+		int32_t t = (int32_t) time + offset;
+		if (t < 0) {
+			t = 0;
+		}
+
+		DmResult rv = DmResult_SUCCESS;
+		DmMessage msg;
+		memset(&msg, 0, sizeof msg);
+
+		switch (status & 0xF0) {
+		case 0x90:
+			if (b2 == 0) {
+				break;
+			}
+			msg.type = DmMessage_NOTE;
+			msg.time = (uint32_t) t;
+			msg.note.on = true;
+			msg.note.note = b1;
+			msg.note.velocity = b2;
+			msg.note.channel = channel;
+			rv = DmMessageList_add(slf, msg);
+			if (rv == DmResult_SUCCESS) {
+				msg.time = (uint32_t) t + (duration > 0 ? duration : 1);
+				msg.note.on = false;
+				rv = DmMessageList_add(slf, msg);
+			}
+			break;
+		case 0xB0:
+			rv = DmSegment_addSeqControl(slf, (uint32_t) t, channel, b1, (float) b2 / 127.f);
+			break;
+		case 0xE0:
+			rv = DmSegment_addSeqPitchBend(slf, (uint32_t) t, channel, (b2 << 7) | b1);
+			break;
+		default:
+			break;
+		}
+
+		if (rv != DmResult_SUCCESS) {
+			return rv;
+		}
+	}
+
+	return DmResult_SUCCESS;
+}
+
+static DmResult DmSegment_parseSequenceCurves(DmMessageList* slf, DmRiff* rif) {
+	uint32_t item_size = 0;
+	DmRiff_readDword(rif, &item_size);
+	if (item_size < 24) {
+		return DmResult_SUCCESS;
+	}
+
+	uint32_t item_count = (rif->len - rif->pos) / item_size;
+	for (uint32_t i = 0; i < item_count; ++i) {
+		uint32_t end_position = rif->pos + item_size;
+		uint32_t start = 0, duration = 0, reset_duration = 0, channel = 0;
+		int16_t offset = 0, start_value = 0, end_value = 0, reset_value = 0;
+		uint8_t type = 0, shape = 0, cc = 0, flags = 0;
+
+		DmRiff_readDword(rif, &start);
+		DmRiff_readDword(rif, &duration);
+		DmRiff_readDword(rif, &reset_duration);
+		DmRiff_readDword(rif, &channel);
+		DmRiff_readShort(rif, &offset);
+		DmRiff_readShort(rif, &start_value);
+		DmRiff_readShort(rif, &end_value);
+		DmRiff_readShort(rif, &reset_value);
+		DmRiff_readByte(rif, &type);
+		DmRiff_readByte(rif, &shape);
+		DmRiff_readByte(rif, &cc);
+		DmRiff_readByte(rif, &flags);
+		rif->pos = end_position;
+
+		int32_t t = (int32_t) start + offset;
+		if (t < 0) {
+			t = 0;
+		}
+
+		// DMUS_CURVET_PBCURVE = 3, DMUS_CURVET_CCCURVE = 4; shapes: 0 linear, 1 instant, 2 exp, 3 log, 4 sine
+		if (type != 3 && type != 4) {
+			continue;
+		}
+
+		uint32_t steps = duration / DmInt_SEQ_CURVE_SPACING;
+		if (shape == 1 || steps == 0) {
+			steps = 0;
+		}
+		for (uint32_t k = 0; k <= steps; ++k) {
+			float phase = steps == 0 ? 1.f : (float) k / (float) steps;
+			switch (shape) {
+			case 2:
+				phase = phase * phase * phase * phase;
+				break;
+			case 3:
+				phase = sqrtf(phase);
+				break;
+			case 4:
+				phase = (sinf((phase - 0.5f) * 3.14159265f) + 1.f) * 0.5f;
+				break;
+			default:
+				break;
+			}
+			float value = (float) start_value + ((float) end_value - (float) start_value) * phase;
+			uint32_t mt = (uint32_t) t + (steps == 0 ? duration : k * DmInt_SEQ_CURVE_SPACING);
+
+			DmResult rv;
+			if (type == 3) {
+				rv = DmSegment_addSeqPitchBend(slf, mt, channel, (int) value);
+			} else {
+				if (value < 0.f) value = 0.f;
+				if (value > 127.f) value = 127.f;
+				rv = DmSegment_addSeqControl(slf, mt, channel, cc, value / 127.f);
+			}
+			if (rv != DmResult_SUCCESS) {
+				return rv;
+			}
+		}
+	}
+
+	return DmResult_SUCCESS;
+}
