import os
import subprocess

# set help text
vars = Variables('custom.py')
vars.Add(EnumVariable('debug', 'Debug level (0 = release version)', '1',
                                 allowed_values=('0', '1', '2'),
                                 ignorecase=2))
vars.Add(EnumVariable('device', 'Target device', 'pc64-linux',
                                 allowed_values=('pc64-linux', 'pc64-windows'),
                                 ignorecase=2))
env = Environment(variables = vars)

debug = int(env['debug'])
device = env['device']

Help(vars.GenerateHelpText(env))

if device == 'pc64-linux':
    # x86-64 (SRW OUT_X64): the runtime is compiled as C++ (PTR32 types, Game-Memory.c low-memory allocator);
    # recompiled code uses absolute 32-bit addresses, so the non-PIE executable is linked low (at 0x10000000)
    env.Append(CCFLAGS = '-O2 -Wall -m64 -x c++ -fno-PIE -fno-exceptions -fno-rtti',
               LINKFLAGS = '-m64 -no-pie -Wl,-Ttext-segment,0x10000000 -Wl,-z,noexecstack')
    env['LINK'] = 'g++'
    env['OBJSUFFIX'] = '.o64'       # the 32-bit build uses .o in the same directories
elif device == 'pc64-windows':
    # Windows x64, cross-compiled with MinGW-w64 (x86_64-w64-mingw32-*). SDL2 and freetype for MinGW:
    # WIN_DEPS=<dir> with <dir>/include/SDL2, <dir>/include/freetype2 and <dir>/lib (see BUILDING.md).
    # Like on Linux, the recompiled code needs everything below 2 GB: fixed image base 0x10000000, no ASLR.
    env['CC'] = 'x86_64-w64-mingw32-gcc'
    env['CXX'] = 'x86_64-w64-mingw32-g++'
    env['LINK'] = 'x86_64-w64-mingw32-g++'
    env['AR'] = 'x86_64-w64-mingw32-ar'
    env['RANLIB'] = 'x86_64-w64-mingw32-ranlib'
    env['PROGSUFFIX'] = '.exe'
    env['OBJSUFFIX'] = '.w64.o'
    win_deps = os.environ.get('WIN_DEPS', '/usr/x86_64-w64-mingw32')
    env.Append(CCFLAGS = '-O2 -Wall -m64 -x c++ -fno-exceptions -fno-rtti -Dmain=SDL_main',
               CPPPATH = [win_deps + '/include/SDL2', win_deps + '/include/freetype2', win_deps + '/include'],
               LIBPATH = [win_deps + '/lib'],
               LINKFLAGS = '-m64 -mwindows -static-libgcc -static-libstdc++ -Wl,--image-base,0x10000000,--disable-dynamicbase,--disable-reloc-section,--disable-high-entropy-va,--nxcompat',
               LIBS = ['mingw32', 'SDL2main', 'SDL2', 'freetype', 'd3d11', 'dxgi', 'dxguid', 'opengl32', 'ws2_32', 'winmm']
              )
    # no libwinpthread-1.dll next to the exe: link it statically
    env.Append(_LIBFLAGS = ' -Wl,-Bstatic -lwinpthread -Wl,-Bdynamic')
if device != 'pc64-windows':
    env.Append(CCFLAGS = ' -O2 -Wall',
               CPPPATH = ['/usr/include/SDL2', '/usr/local/include/SDL2', '/usr/include/freetype2', '/usr/local/include'],
               LIBPATH = ['/usr/local/lib'],
               LIBS = ['SDL2', 'freetype', 'pthread', 'm']
              )

if debug <= 0:
    env.Append(LINKFLAGS = '-s')
elif debug == 1:
    env.Append(CCFLAGS = '-g')
else:
    env.Append(CCFLAGS = '-g -D__DEBUG__')

if 'PATH_INC' in os.environ:
    env.Append(CPPPATH = os.environ['PATH_INC'].split(os.pathsep))
if 'PATH_LIB' in os.environ:
    env.Append(LIBPATH = os.environ['PATH_LIB'].split(os.pathsep))

arch_objs = SConscript('x64/SConscript', exports='device env')

# Godot (LibGodot) as the window system and 3D renderer: host_godot.cpp with godot-cpp
# (GODOT_CPP=<godot-cpp checkout with bin/libgodot-cpp.*.a built for the libgodot used>). libgodot itself is
# loaded at run time (dlopen), see host_godot.cpp.
godot_objs = []
godot_cpp = os.environ.get('GODOT_CPP', '/home/teemu/sorsa/godot-cpp')
godot_lib = None
if device == 'pc64-linux' and os.path.isdir(godot_cpp):
    for name in ['libgodot-cpp.linux.template_release.x86_64.a', 'libgodot-cpp.linux.template_debug.x86_64.a']:
        if os.path.exists(os.path.join(godot_cpp, 'bin', name)):
            godot_lib = os.path.join(godot_cpp, 'bin', name)
            break
if godot_lib is not None:
    env.Append(CPPDEFINES = ['HAVE_GODOT'])
    genv = env.Clone()
    # godot-cpp uses dynamic_cast (the rest of the runtime is built without RTTI)
    genv['CCFLAGS'] = str(genv['CCFLAGS']).replace('-fno-rtti', '')
    genv.Append(CCFLAGS = ' -std=c++17',
                CPPPATH = [godot_cpp + '/include', godot_cpp + '/gen/include', godot_cpp + '/gdextension'])
    godot_objs = [genv.Object('host_godot.cpp'), godot_lib]
    env.Append(LIBS = ['dl'])
else:
    print('Godot (godot-cpp) not found: SDL window only')

env.Program('SR-AvP2' + ('-x64' if device == 'pc64-linux' else ''), Glob('*.c') + arch_objs + godot_objs)
