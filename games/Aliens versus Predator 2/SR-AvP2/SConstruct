import os
import subprocess

# set help text
vars = Variables('custom.py')
vars.Add(EnumVariable('debug', 'Debug level (0 = release version)', '1',
                                 allowed_values=('0', '1', '2'),
                                 ignorecase=2))
vars.Add(EnumVariable('device', 'Target device', 'pc64-linux',
                                 allowed_values=('pc64-linux', 'pc64-windows', 'pc64-macos', 'arm64-macos'),
                                 ignorecase=2))
# blob=1: the recompiled code as a separate image at a fixed low address (tools/mkblob.py, blob.c, asmsyms.h) and a
# position independent program - how macOS has to do it; on Linux it tests that the runtime doesn't need to be low
vars.Add(EnumVariable('blob', 'Recompiled code as a separate image (1) or linked in (0)', '0',
                                 allowed_values=('0', '1')))
# blob_kit=<dir>: the images and their link tables made elsewhere (tools/mkmackit.sh on Linux: <dir>/<program>.blob,
# <dir>/blob_link_<program>.cpp) - then neither nasm, GNU binutils nor the generated assembler are needed here
vars.Add(PathVariable('blob_kit', 'Prebuilt recompiled-code images (blob mode)', '', PathVariable.PathAccept))
# llasm=1: the recompiled code from SRW's llasm output (llasm/SConscript: llasm -> LLVM -> llc) instead of the x86-64
# assembler - how native arm64 works; on x86-64 Linux it tests the llasm version. ptrofs=1: game addresses are 32-bit
# offsets from a base (PTROFS_64BIT, a position independent program) - required on arm64 macOS
vars.Add(EnumVariable('llasm', 'Recompiled code through llasm (1) or the x86-64 assembler (0)', '0',
                                 allowed_values=('0', '1')))
vars.Add(EnumVariable('ptrofs', 'llasm: game addresses as offsets from a base (1) or direct low addresses (0)', '0',
                                 allowed_values=('0', '1')))
# llasm_kit=<dir>: the llasm objects made elsewhere (tools/mkarm64kit.sh on Linux: <dir>/llasm/*.o) - then neither llasm
# nor LLVM is needed here (device=arm64-macos: the directory mac-kit-arm64 next to SConstruct by default)
vars.Add(PathVariable('llasm_kit', 'Prebuilt llasm objects (llasm=1)', '', PathVariable.PathAccept))
env = Environment(variables = vars)

debug = int(env['debug'])
device = env['device']
blob = (env['blob'] == '1') or (device == 'pc64-macos')     # macOS: always
blob_kit = env['blob_kit'] or (os.path.isdir('mac-kit') and device == 'pc64-macos' and 'mac-kit') or ''
# native arm64 macOS: always the llasm version with pointer offsets (arm64 programs can't use the low 4 GB)
use_llasm = (env['llasm'] == '1') or (device == 'arm64-macos')
ptrofs = use_llasm and ((env['ptrofs'] == '1') or (device == 'arm64-macos'))
llasm_kit = env['llasm_kit'] or (os.path.isdir('mac-kit-arm64') and device == 'arm64-macos' and 'mac-kit-arm64') or ''
if use_llasm:
    blob = False

Help(vars.GenerateHelpText(env))

if device == 'pc64-linux':
    # x86-64 (SRW OUT_X64): the runtime is compiled as C++ (PTR32 types, Game-Memory.c low-memory allocator);
    # recompiled code uses absolute 32-bit addresses, so the non-PIE executable is linked low (at 0x10000000)
    if use_llasm and ptrofs:
        env.Append(CCFLAGS = '-O2 -Wall -m64 -x c++ -fPIE -fno-exceptions -fno-rtti',
                   LINKFLAGS = '-m64 -pie -Wl,-z,noexecstack',
                   CPPDEFINES = ['SR_LLASM', 'PTROFS_64BIT'],
                   LLASMFLAGS = '-m64 -inline-idiv -inline-float -pic -ptrofs',
                   LLVMFLAGS = '-mtriple=x86_64-unknown-linux-gnu --relocation-model=pic')
        env['OBJSUFFIX'] = '.llp.o'
    elif use_llasm:
        env.Append(CCFLAGS = '-O2 -Wall -m64 -x c++ -fno-PIE -fno-exceptions -fno-rtti',
                   LINKFLAGS = '-m64 -no-pie -Wl,-Ttext-segment,0x10000000 -Wl,-z,noexecstack',
                   CPPDEFINES = ['SR_LLASM'],
                   LLASMFLAGS = '-m64 -inline-idiv -inline-float',
                   LLVMFLAGS = '-mtriple=x86_64-unknown-linux-gnu')
        env['OBJSUFFIX'] = '.lla.o'
    elif blob:
        env.Append(CCFLAGS = '-O2 -Wall -m64 -x c++ -fPIE -fno-exceptions -fno-rtti',
                   LINKFLAGS = '-m64 -pie -Wl,-z,noexecstack',
                   CPPDEFINES = ['SR_BLOB'])
    else:
        env.Append(CCFLAGS = '-O2 -Wall -m64 -x c++ -fno-PIE -fno-exceptions -fno-rtti',
                   LINKFLAGS = '-m64 -no-pie -Wl,-Ttext-segment,0x10000000 -Wl,-z,noexecstack')
    env['LINK'] = 'g++'
    if not use_llasm:
        env['OBJSUFFIX'] = '.pie.o64' if blob else '.o64'   # the 32-bit build uses .o in the same directories
elif device == 'pc64-windows':
    # Windows x64, cross-compiled with MinGW-w64 (x86_64-w64-mingw32-*). SDL2 and freetype for MinGW:
    # WIN_DEPS=<dir> with <dir>/include/SDL2, <dir>/include/freetype2 and <dir>/lib (see BUILDING.md).
    # Like on Linux, the recompiled code needs everything below 2 GB: fixed image base 0x10000000, no ASLR.
    env['CC'] = 'x86_64-w64-mingw32-gcc'
    env['CXX'] = 'x86_64-w64-mingw32-g++'
    env['LINK'] = 'x86_64-w64-mingw32-g++'
    env['AR'] = 'x86_64-w64-mingw32-ar'
    env['RANLIB'] = 'x86_64-w64-mingw32-ranlib'
    env['PROGSUFFIX'] = '.exe'
    env['OBJSUFFIX'] = '.w64.o'
    win_deps = os.environ.get('WIN_DEPS', '/usr/x86_64-w64-mingw32')
    env.Append(CCFLAGS = '-O2 -Wall -m64 -x c++ -fno-exceptions -fno-rtti -Dmain=SDL_main',
               CPPPATH = [win_deps + '/include/SDL2', win_deps + '/include/freetype2', win_deps + '/include'],
               LIBPATH = [win_deps + '/lib'],
               LINKFLAGS = '-m64 -mwindows -static-libgcc -static-libstdc++ -Wl,--image-base,0x10000000,--disable-dynamicbase,--disable-reloc-section,--disable-high-entropy-va,--nxcompat',
               LIBS = ['mingw32', 'SDL2main', 'SDL2', 'freetype', 'd3d11', 'dxgi', 'dxguid', 'opengl32', 'ws2_32', 'winmm']
              )
    # no libwinpthread-1.dll next to the exe: link it statically
    env.Append(_LIBFLAGS = ' -Wl,-Bstatic -lwinpthread -Wl,-Bdynamic')
elif device == 'pc64-macos':
    # macOS on Intel, or on Apple Silicon through Rosetta 2: an x86-64 program (the recompiled code is x86-64). The
    # recompiled code is a separate image at a fixed low address (blob.c: Mach-O has no 32-bit absolute relocations
    # and the program itself is above 4 GB); __PAGEZERO is shrunk (it covers the low 4 GB otherwise) so that the
    # image and the game's memory fit below 2 GB. Dependencies from an x86-64 Homebrew (/usr/local), see
    # SRW-games/Aliens versus Predator 2/BUILDING-macOS.md.
    env['CC'] = 'clang'
    env['CXX'] = 'clang++'
    env['LINK'] = 'clang++'
    env['OBJSUFFIX'] = '.mac.o'
    arch = ' -arch x86_64 -mmacosx-version-min=11.0'
    env.Append(CCFLAGS = arch + ' -O2 -Wall -x c++ -fno-exceptions -fno-rtti -Wno-unused-function -Wno-unused-variable',
               LINKFLAGS = arch + ' -Wl,-pagezero_size,0x10000',
               CPPDEFINES = ['SR_BLOB'])
    env['ENV']['PATH'] = os.environ.get('PATH', '')
    env['ENV']['PKG_CONFIG_PATH'] = os.environ.get('PKG_CONFIG_PATH', '/usr/local/lib/pkgconfig')
    env.ParseConfig('pkg-config --cflags --libs sdl2 freetype2')
    env.Append(LIBS = ['pthread', 'm'])
elif device == 'arm64-macos':
    # native Apple Silicon (no Rosetta): the recompiled code from the llasm version (llasm/SConscript, or its objects
    # from a kit made on Linux: tools/mkarm64kit.sh), game addresses as offsets from pointer_offset (Game-Memory.c
    # finds a 4 GB window below the program). Dependencies from Homebrew (/opt/homebrew), see
    # SRW-games/Aliens versus Predator 2/BUILDING-macOS.md.
    env['CC'] = 'clang'
    env['CXX'] = 'clang++'
    env['LINK'] = 'clang++'
    env['OBJSUFFIX'] = '.arm64.o'
    arch = ' -arch arm64 -mmacosx-version-min=11.0'
    env.Append(CCFLAGS = arch + ' -O2 -Wall -x c++ -fno-exceptions -fno-rtti -Wno-unused-function -Wno-unused-variable',
               LINKFLAGS = arch,
               CPPDEFINES = ['SR_LLASM', 'PTROFS_64BIT'],
               LLASMFLAGS = '-m64 -inline-idiv -inline-float -pic -ptrofs',
               LLVMFLAGS = '-mtriple=arm64-apple-macosx11.0.0 --relocation-model=pic')
    env['ENV']['PATH'] = os.environ.get('PATH', '')
    env['ENV']['PKG_CONFIG_PATH'] = os.environ.get('PKG_CONFIG_PATH', '/opt/homebrew/lib/pkgconfig')
    env.ParseConfig('pkg-config --cflags --libs sdl2 freetype2')
    env.Append(LIBS = ['pthread', 'm'])
if device == 'pc64-linux':
    env.Append(CCFLAGS = ' -O2 -Wall',
               CPPPATH = ['/usr/include/SDL2', '/usr/local/include/SDL2', '/usr/include/freetype2', '/usr/local/include'],
               LIBPATH = ['/usr/local/lib'],
               LIBS = ['SDL2', 'freetype', 'pthread', 'm']
              )

if debug <= 0:
    env.Append(LINKFLAGS = '-s')
elif debug == 1:
    env.Append(CCFLAGS = '-g')
else:
    env.Append(CCFLAGS = '-g -D__DEBUG__')

if 'PATH_INC' in os.environ:
    env.Append(CPPPATH = os.environ['PATH_INC'].split(os.pathsep))
if 'PATH_LIB' in os.environ:
    env.Append(LIBPATH = os.environ['PATH_LIB'].split(os.pathsep))

# FFmpeg (libavformat, libavcodec) decodes the Bink movies (bink.c); without it the movies are skipped
if device in ('pc64-linux', 'pc64-macos', 'arm64-macos') and os.environ.get('NO_FFMPEG') is None:
    try:
        subprocess.check_output(['pkg-config', '--exists', 'libavformat', 'libavcodec', 'libavutil'])
        env.ParseConfig('pkg-config --cflags --libs libavformat libavcodec libavutil')
        env.Append(CPPDEFINES = ['HAVE_FFMPEG'])
    except (OSError, subprocess.CalledProcessError):
        print('FFmpeg (libavformat/libavcodec) not found: no movies')

# GothicKit's dmusic (DirectMusic re-implementation, built static with the patches in dmusic-patches/) plays the music
# (music.c): DMUSIC=<checkout> with build-static/libdmusic.a; without it there is no music
dmusic_libs = []
dmusic = os.environ.get('DMUSIC', '/home/teemu/sorsa/dmusic')
if device in ('pc64-linux', 'pc64-macos', 'arm64-macos') and os.path.exists(os.path.join(dmusic, 'build-static', 'libdmusic.a')):
    env.Append(CPPDEFINES = ['HAVE_DMUSIC', 'DM_STATIC=1'], CPPPATH = [os.path.join(dmusic, 'include')])
    dmusic_libs = [File(os.path.join(dmusic, 'build-static', 'libdmusic.a')), File(os.path.join(dmusic, 'build-static', 'vendor', 'libdmusic-tsf.a'))]
else:
    print('dmusic not found: no music')

if use_llasm:
    # the llasm version: its own CPU emulation and entry points instead of x64/*.asm and x64/asm-cpu.c
    common_asm_objs, avp2_objs, ph_objs = SConscript('llasm/SConscript', exports='env llasm_kit')
    common_c_objs = []
else:
    common_asm_objs, common_c_objs, avp2_objs, ph_objs = SConscript('x64/SConscript', exports='device env')

# Godot (LibGodot) as the window system and 3D renderer: host_godot.cpp with godot-cpp
# (GODOT_CPP=<godot-cpp checkout with bin/libgodot-cpp.*.a built for the libgodot used>). libgodot itself is
# loaded at run time (dlopen), see host_godot.cpp.
godot_objs = []
godot_cpp = os.environ.get('GODOT_CPP', '/home/teemu/sorsa/godot-cpp')
godot_lib = None
godot_platform = 'macos' if device in ('pc64-macos', 'arm64-macos') else 'linux'
godot_arch = 'arm64' if device == 'arm64-macos' else 'x86_64'
if device in ('pc64-linux', 'pc64-macos', 'arm64-macos') and os.path.isdir(godot_cpp):
    for name in ['libgodot-cpp.%s.template_release.%s.a' % (godot_platform, godot_arch), 'libgodot-cpp.%s.template_debug.%s.a' % (godot_platform, godot_arch),
                 'libgodot-cpp.%s.template_release.universal.a' % godot_platform, 'libgodot-cpp.%s.template_debug.universal.a' % godot_platform]:
        if os.path.exists(os.path.join(godot_cpp, 'bin', name)):
            godot_lib = os.path.join(godot_cpp, 'bin', name)
            break
if godot_lib is not None:
    env.Append(CPPDEFINES = ['HAVE_GODOT'])
    genv = env.Clone()
    # godot-cpp uses dynamic_cast (the rest of the runtime is built without RTTI)
    genv['CCFLAGS'] = str(genv['CCFLAGS']).replace('-fno-rtti', '')
    genv.Append(CCFLAGS = ' -std=c++17',
                CPPPATH = [godot_cpp + '/include', godot_cpp + '/gen/include', godot_cpp + '/gdextension'])
    godot_objs = [genv.Object('host_godot.cpp'), genv.Object('render3d.cpp'), godot_lib]
    env.Append(LIBS = ['dl'])
else:
    print('Godot (godot-cpp) not found: SDL window only')

# two programs from the same runtime: Aliens versus Predator 2 and Primal Hunt (game_avp2.c / game_ph.c and
# each game's recompiled modules)
suffix = ('-llasm-ptrofs' if ptrofs else '-llasm' if use_llasm else '-x64-blob' if blob else '-x64') if device == 'pc64-linux' else ''
def runtime_object(f):
    # blob / ptrofs: the runtime's allocations in the game's memory (lowalloc.h) - not in the allocator itself, nor where the memory
    # never reaches the game (rezfs/music: dmusic frees what it gets with the system's free; the mixer and Bink's
    # decoder state)
    if (blob or ptrofs) and os.path.basename(str(f)) not in ('Game-Memory.c', 'lowalloc.c', 'rezfs.c', 'music.c', 'mixer.c', 'bink.c'):
        return env.Object(f, CCFLAGS = env['CCFLAGS'] + ['-include', 'lowalloc.h'])
    return env.Object(f)
runtime_objs = [runtime_object(f) for f in Glob('*.c') if not os.path.basename(str(f)).startswith('game_')]
blob_files = []
def recompiled(name, module_objs):
    # the recompiled code: linked in, or (blob) its image next to the program and the generated link table
    if not blob:
        return common_asm_objs + module_objs
    if blob_kit:
        blob_files.append(env.InstallAs(name + '.blob', os.path.join(blob_kit, name + '.blob')))
        return [env.Object('blob/blob_link_' + name + env['OBJSUFFIX'], os.path.join(blob_kit, 'blob_link_' + name + '.cpp'),
                           CPPPATH = env['CPPPATH'] + ['#'])]
    env['ENV']['PATH'] = os.environ.get('PATH', '')
    mkblob = '#../../../SRW-games/Aliens versus Predator 2/tools/mkblob.py'
    outs = env.Command(['blob/' + name + '.blob', 'blob/blob_link_' + name + '.cpp'], common_asm_objs + module_objs + ['asmsyms.h', mkblob],
                       'python3 ${SOURCES[-1].abspath} --name ' + name + ' --asmsyms ${SOURCES[-2]} --out ${TARGET.dir} ' +
                       ' '.join('${SOURCES[%d]}' % i for i in range(len(common_asm_objs + module_objs))))
    blob_files.append(env.InstallAs(name + '.blob', outs[0]))
    return [env.Object(outs[1], CPPPATH = env['CPPPATH'] + ['#'])]

programs = env.Program('SR-AvP2' + suffix, runtime_objs + [env.Object('game_avp2.c')] + common_c_objs + recompiled('SR-AvP2' + suffix, avp2_objs) + godot_objs + dmusic_libs)
if ph_objs or (blob_kit and os.path.exists(os.path.join(blob_kit, 'SR-AvP2PH' + suffix + '.blob'))):
    programs += env.Program('SR-AvP2PH' + suffix, runtime_objs + [env.Object('game_ph.c')] + common_c_objs + recompiled('SR-AvP2PH' + suffix, ph_objs) + godot_objs + dmusic_libs)
else:
    print('Primal Hunt modules (x64/ph-*) not generated: SR-AvP2PH not built')

# the programs and their images (not every object SConscript declares: with a blob kit the assembler isn't needed)
Default(programs, blob_files)
